NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Get this from Atlas > Connect > Drivers.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartbin?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins for the client
CLIENT_ORIGIN=http://localhost:5173
